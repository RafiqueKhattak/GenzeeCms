APP_NAME="GenzeeLogics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://genzeelogics.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# This server also runs Frappe ERPNext (MySQL). Use a DEDICATED database
# and DEDICATED MySQL user for this app — never reuse Frappe's database or
# credentials. The 'laracms' database should already exist; just verify and
# set real credentials:
#   mysql -u root -p -e "SHOW DATABASES LIKE 'laracms';"   # should exist
#   mysql -u root -p -e "CREATE USER 'laracms'@'localhost' IDENTIFIED BY 'CHANGE-ME';"
#   mysql -u root -p -e "GRANT ALL PRIVILEGES ON laracms.* TO 'laracms'@'localhost';"
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laracms
DB_USERNAME=laracms
DB_PASSWORD=CHANGE-ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@genzeelogics.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Inertia SSR ---
# Must stay enabled in production — see CLAUDE.md "Why SSR matters here".
# The default port (13714) only needs changing if something else on this
# box already binds it (check with: sudo ss -ltnp | grep 13714).
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# --- Admin seeding (used once by AdminUserSeeder / `php artisan db:seed`) ---
# Set a real password before first deploy; the seeder will not print/store
# it anywhere else. Change it via the admin panel after first login, then
# these two lines can be removed.
ADMIN_EMAIL=admin@genzeelogics.com
ADMIN_PASSWORD=CHANGE-ME-BEFORE-FIRST-DEPLOY

# --- Content policy checker ---
# Leave as-is unless/until an LLM-backed checker is introduced (see
# config/policy-checker.php and CLAUDE.md).
POLICY_CHECKER_DRIVER=rule-based

# --- Keyword suggestions (optional) ---
# Free API key from newsapi.org, used only to pull public headlines into the
# /admin/keywords idea queue. Leave unset to use manual keyword entry only.
# NEWS_API_KEY=
